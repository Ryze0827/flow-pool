# Copy to .env on the server and replace the values. Never commit the real file.
# Must be the SAME Sub2API backend used by erxinai (its current dev proxy target).
# A loopback URL is also valid when it points to that same running backend.
FLOWPOOL_SUB2API_URL=https://mgr.aiwxin.com
# Optional legacy fallback; prefer configuring PostgreSQL on the Connection Settings page.
# Saved page configuration takes precedence. URL-encode special characters for this DSN.
# Prefer a SELECT-only role. The application enforces read-only transactions too.
# Needed tables: users, groups, redeem_codes, user_allowed_groups,
# user_group_rate_multipliers, settings (admin_api_key only).
# FLOWPOOL_SUB2API_PG_DSN=postgresql://flowpool_reader:replace-password@127.0.0.1:5432/sub2api
# Add the public Nginx hostname when using a reverse proxy.
FLOWPOOL_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver,flowpool.example.com
